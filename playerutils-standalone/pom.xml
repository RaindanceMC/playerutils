<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.raindancer.modules</groupId>
        <artifactId>playerutils-build</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>playerutils-standalone</artifactId>
    <!-- Published at the plugin's own version. -->
    <version>${plugin.version}</version>
    <packaging>jar</packaging>

    <name>Rain's Player Utils</name>
    <description>
        Rain's Player Utils, as a plugin of its own. Nothing here but a build file and a descriptor:
        the playerutils module and the standard wrapper are shaded together, and that is the whole
        plugin.
    </description>

    <properties>
        <!-- The name the server sees, and the name of its data folder. -->
        <plugin.name>RainsPlayerUtils</plugin.name>

        <!-- 0.1.0: the first release. Fly, heal, feed, damage, starve, drown, breathe, extinguish,
             ignite, explode, launch, scale, speed, wipe, spectate, sudo, ping, status, hunger,
             effects, near, position and /player, every one aimed by name, nickname or selector.
             0.3.0: Paper 26.3 natively (paper-api 26.3, api-version 26.3); no longer loads on 26.2.
             0.4.0: network: /position (/whereis) finds a player on another server and says which, and where they stand;
             /spectate <player> on another server takes you there and resumes watching on arrival, the way back leading
             to the server you left. -->
        <!-- 0.4.1: /fly is Core's fly lease — flying out of a claim ends the claim's flight even when /fly was on when they walked in; /fly in a flying claim turns your own flight on. Needs RainsCore with Flight.FLY. -->
        <!-- 0.7.0: screens for /screen — everybody's own ping and the server's ping board (RainsCore 2.10). -->
        <plugin.version>0.7.0</plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>playerutils-module</artifactId>
        </dependency>
        <dependency>
            <groupId>de.raindancer.modules</groupId>
            <artifactId>modules-wrapper</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${plugin.name}-${plugin.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- The descriptor names the version, and a version written twice is one that drifts. -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
            <!--
              StandaloneJarTest reads the jar this build produces, so it has to run after it exists.
              Surefire bound to a later phase rather than failsafe, which is one more plugin to have
              cached — this build has to work offline.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>after-the-jar-exists</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
